# Get from @BotFather on Telegram
BOT_TOKEN=your_bot_token_here

# Secret token for webhook verification (generate a random string)
WEBHOOK_SECRET=your_random_secret_here

# Your deployed URL (set after Vercel deploy)
WEBAPP_URL=https://your-app.vercel.app

# Turso database (https://turso.tech)
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token

# Analytics (optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Webmaster verification tokens (optional)
# Google Search Console HTML tag content
GSC_VERIFICATION=
# Bing Webmaster Tools meta tag (msvalidate.01)
BING_VERIFICATION=
# Yandex Webmaster meta tag
YANDEX_VERIFICATION=

# Telegram WebApp init_data max age in seconds (anti-replay window, default: 900)
INIT_DATA_MAX_AGE_SECONDS=900

# Stripe credentials are retained only for historical refunds/disputes. New
# Telegram digital-goods purchases are always Stars-only.

# No-charge end-to-end testing mode (for staging/testing only)
ENABLE_FAKE_PAYMENTS=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Unix timestamp after which any unexpected Gategram card completion is
# automatically refunded instead of fulfilled (default: 2026-08-18 00:00 UTC).
STRIPE_LEGACY_CUTOFF_UNIX=1787011200

# Versioned terms shown and recorded for creators and buyers
CREATOR_TERMS_VERSION=v2-2026-08-17
CREATOR_TERMS_URL=https://gategram.app/docs/creator-terms
BUYER_TERMS_VERSION=v2-2026-08-17

# Creator payout rate. Set from Telegram's bot-developer reward after FX and a
# liquidity/fees reserve; never use the buyer acquisition price of a Star.
PAYOUT_EUR_PER_STAR=0.0100
PAYOUT_HOLD_DAYS=21

# Required public bot username used to generate reliable deep links in the Mini
# App. Set your own bot username without the leading @.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=your_bot_username

# Optional comma-separated Telegram user IDs allowed to use admin commands
# (/admin_disable <product_id>, /admin_enable <product_id>) and /api/admin actions
ADMIN_TELEGRAM_IDS=

# Replay-protection table retention and cleanup sampling for Telegram update_id idempotency
PROCESSED_UPDATES_TTL_DAYS=3
PROCESSED_UPDATES_CLEANUP_RATE=0.05

# Secret for delivery-retry cron endpoint (generate a random string)
CRON_SECRET=
