{
  "name": "paywall-tg",
  "version": "1.0.0",
  "description": "Telegram Mini App — sell digital content with Stars payments",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "test": "node --test --test-concurrency=1 test/validate.test.js test/initdata.test.js test/payments.test.js test/payout-statements.test.js",
    "test:db": "node scripts/run-db-tests.mjs",
    "test:integration": "node scripts/run-integration-tests.mjs",
    "test:all": "npm test && npm run test:db && npm run test:integration",
    "audit:deps": "npm audit --omit=dev"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "grammy": "~1.44.0",
    "next": "~16.3.1",
    "pdfkit": "^0.19.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "stripe": "~17.7.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.0"
  },
  "overrides": {
    "qs": "^6.15.2",
    "ws": "^8.20.1",
    "nanoid": "^3.3.18",
    "postcss": "^8.5.26",
    "sharp": "^0.35.3"
  }
}
